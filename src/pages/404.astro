---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { defaultLocale, href, ui } from '@/i18n/ui';

const lang = defaultLocale;
const copy = ui[lang];
---

<BaseLayout lang={lang} title={copy.notFound} description={copy.notFoundBody}>
  <div class="mx-auto max-w-xl px-4 py-24">
    <p class="text-sm text-[var(--color-muted)]">404</p>
    <h1 class="mt-2 font-sans text-3xl font-medium tracking-tight">{copy.notFound}</h1>
    <p class="mt-3 text-[var(--color-muted)]">{copy.notFoundBody}</p>
    <p class="mt-8 text-sm">
      <a class="underline underline-offset-2 hover:text-[var(--color-muted)]" href={href(lang)}>{copy.navHome}</a>
      <span class="mx-2 text-[var(--color-line)]">/</span>
      <a class="underline underline-offset-2 hover:text-[var(--color-muted)]" href={href(lang, 'posts')}>{copy.navPosts}</a>
    </p>
  </div>
</BaseLayout>
