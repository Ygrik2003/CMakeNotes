---
import { render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { href, locales, otherLocale, type Locale } from '@/i18n/ui';
import { getPost, getPosts, getTranslation, parsePostId } from '@/lib/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of locales) {
    const posts = await getPosts(lang);
    for (const post of posts) {
      const { slug } = parsePostId(post.id);
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const post = await getPost(lang, slug);
if (!post) {
  return Astro.redirect(href(lang, 'posts'));
}

const translation = await getTranslation(lang, slug);
const posts = await getPosts(lang);
const index = posts.findIndex((item) => item.id === post.id);
const next = index > 0 ? posts[index - 1] : undefined;
const prev = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const { Content, headings } = await render(post);
---

<PostLayout
  lang={lang}
  post={post}
  headings={headings}
  translationExists={Boolean(translation)}
  translationHref={translation ? href(otherLocale(lang), 'posts', slug) : undefined}
  prev={prev}
  next={next}
>
  <Content />
</PostLayout>
