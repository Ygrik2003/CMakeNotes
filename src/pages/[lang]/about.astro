---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href, localePaths, otherLocale, ui, type Locale } from '@/i18n/ui';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const copy = ui[lang];
const about = await getEntry('about', lang);
if (!about) {
  return Astro.redirect(href(lang));
}
const { Content } = await render(about);
---

<BaseLayout
  lang={lang}
  title={about.data.title}
  description={copy.navAbout}
  translationHref={href(otherLocale(lang), 'about')}
>
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6" data-pagefind-body>
    <h1 class="font-sans text-3xl font-semibold tracking-tight">{about.data.title}</h1>
    <div class="prose about-body mt-8">
      {about.data.avatar && (
        <img
          src={about.data.avatar}
          alt=""
          width="160"
          height="160"
          class="about-avatar"
        />
      )}
      <Content />
    </div>
  </section>
</BaseLayout>
