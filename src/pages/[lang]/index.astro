---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { href, localePaths, site, ui, type Locale } from '@/i18n/ui';
import { getPosts } from '@/lib/posts';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const copy = ui[lang];
const brand = site[lang];
const posts = (await getPosts(lang)).slice(0, 6);
---

<BaseLayout lang={lang} title={brand.name} description={brand.description}>
  <section class="mx-auto max-w-6xl px-4 pb-16 pt-12 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-accent)]">CMake</p>
    <h1 class="mt-3 max-w-3xl font-sans text-4xl font-semibold tracking-tight sm:text-5xl">{brand.name}</h1>
    <p class="mt-4 max-w-2xl text-lg text-[var(--color-muted)]">{brand.tagline} {brand.description}</p>
    <div class="mt-8 flex flex-wrap gap-3 text-sm">
      <a class="rounded-full bg-[var(--color-accent)] px-4 py-2 font-medium text-white hover:bg-[var(--color-accent-2)]" href={href(lang, 'posts')}>{copy.allPosts}</a>
      <a class="rounded-full border border-[var(--color-line)] px-4 py-2 hover:border-[var(--color-accent)]" href={href(lang, 'about')}>{copy.navAbout}</a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="mb-5 flex items-end justify-between">
      <h2 class="font-sans text-xl font-semibold">{copy.latest}</h2>
      <a class="text-sm text-[var(--color-accent-2)]" href={href(lang, 'posts')}>{copy.allPosts} →</a>
    </div>
    {posts.length === 0 ? (
      <p class="text-[var(--color-muted)]">{copy.noPosts}</p>
    ) : (
      <div class="grid gap-4">
        {posts.map((post) => <PostCard lang={lang} post={post} />)}
      </div>
    )}
  </section>
</BaseLayout>
