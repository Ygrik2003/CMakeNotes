---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { href, localePaths, site, ui, type Locale } from '@/i18n/ui';
import { getPosts } from '@/lib/posts';

export function getStaticPaths() {
  return localePaths();
}

const lang = Astro.params.lang as Locale;
const copy = ui[lang];
const brand = site[lang];
const posts = (await getPosts(lang)).slice(0, 6);
---

<BaseLayout lang={lang} title={brand.name}>
  <section class="mx-auto max-w-3xl px-4 pb-12 pt-14 sm:px-6">
    <h1 class="font-sans text-3xl font-medium tracking-tight sm:text-4xl">{brand.name}</h1>
    <p class="mt-6 text-sm">
      <a class="underline underline-offset-2 hover:text-[var(--color-muted)]" href={href(lang, 'posts')}>{copy.allPosts}</a>
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <div class="mb-6 flex items-baseline justify-between gap-4 border-b border-[var(--color-line)] pb-3">
      <h2 class="font-sans text-sm font-medium">{copy.latest}</h2>
      <a class="text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]" href={href(lang, 'posts')}>{copy.allPosts} →</a>
    </div>
    {posts.length === 0 ? (
      <p class="text-[var(--color-muted)]">{copy.noPosts}</p>
    ) : (
      <div>
        {posts.map((post) => <PostCard lang={lang} post={post} />)}
      </div>
    )}
  </section>
</BaseLayout>
