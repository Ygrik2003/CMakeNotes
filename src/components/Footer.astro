---
import { href, site, ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = ui[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {year} {site[lang].name}.</p>
    <a class="text-[var(--color-accent-2)] underline underline-offset-2" href={href(lang, 'rss.xml')}>{copy.rss}</a>
  </div>
</footer>
