---
import { href, site, ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const copy = ui[lang];
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-line)]">
  <div class="mx-auto flex max-w-3xl flex-col gap-2 px-4 py-6 text-sm text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <p>© {year} {site[lang].name}</p>
    <a class="hover:text-[var(--color-ink)]" href={href(lang, 'rss.xml')}>{copy.rss}</a>
  </div>
</footer>
