---
import { href, type Locale } from '../i18n/ui';
import { tagSlug } from '../lib/posts';

interface Props {
  lang: Locale;
  tags: string[];
}

const { lang, tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li>
        <a
          class="rounded-full border border-[var(--color-line)] bg-[var(--color-card)] px-2.5 py-0.5 font-sans text-xs text-[var(--color-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-ink)]"
          href={href(lang, 'tags', tagSlug(tag))}
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
