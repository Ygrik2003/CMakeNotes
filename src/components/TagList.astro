---
import { href, type Locale } from '../i18n/ui';
import { tagSlug } from '../lib/posts';

interface Props {
  lang: Locale;
  tags: string[];
}

const { lang, tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-x-3 gap-y-1">
    {tags.map((tag) => (
      <li>
        <a
          class="font-sans text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]"
          href={href(lang, 'tags', tagSlug(tag))}
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
)}
