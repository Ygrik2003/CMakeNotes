---
import { formatDate, href, ui, type Locale } from '../i18n/ui';
import { parsePostId, readingTime, type Post } from '../lib/posts';
import TagList from './TagList.astro';

interface Props {
  lang: Locale;
  post: Post;
}

const { lang, post } = Astro.props;
const { slug } = parsePostId(post.id);
const copy = ui[lang];
const minutes = readingTime(post.body ?? '', lang);
---

<article class="border-b border-[var(--color-line)] py-6 first:pt-0">
  <p class="text-sm text-[var(--color-muted)]">
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
    <span aria-hidden="true"> · </span>
    <span>{copy.readingTime(minutes)}</span>
  </p>
  <h2 class="mt-1.5 font-sans text-xl font-medium tracking-tight">
    <a class="hover:text-[var(--color-muted)]" href={href(lang, 'posts', slug)}>{post.data.title}</a>
  </h2>
  <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{post.data.description}</p>
  <div class="mt-3 flex items-center justify-between gap-3">
    <TagList lang={lang} tags={post.data.tags} />
    <a class="shrink-0 text-sm text-[var(--color-muted)] hover:text-[var(--color-ink)]" href={href(lang, 'posts', slug)}>{copy.readMore} →</a>
  </div>
</article>
